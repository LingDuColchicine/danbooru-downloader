{
  "name": "danbooru-downloader",
  "version": "0.1.0",
  "description": "A desktop Danbooru image downloader prototype.",
  "author": "Night7zx",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "main": "electron/main.js",
  "scripts": {
    "web": "node web/server.mjs",
    "electron:dev": "electron .",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.night7zx.danbooru-downloader",
    "productName": "Danbooru Downloader",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "icons/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "identity": null
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3"
  }
}
